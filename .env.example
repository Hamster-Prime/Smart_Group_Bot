# Telegram Bot
BOT_TOKEN=
SUPER_ADMIN_ID=

# Logging
LOG_LEVEL=INFO
LOG_THIRD_PARTY_LEVEL=WARNING
LOG_COLOR=on
LOG_TO_FILE=false
LOG_FILE_PATH=bot.log
LOG_FILE_MAX_BYTES=5242880
LOG_FILE_BACKUP_COUNT=3

# Model provider profiles
# MODEL_PROVIDER_<NAME>_PROVIDER=gemini/openai/anthropic/openai_compatible/...
# MODEL_PROVIDER_<NAME>_API_KEY=...
# MODEL_PROVIDER_<NAME>_API_BASE=... (optional; use the full upstream endpoint URL when overriding)
# Endpoint format is auto-detected from API_BASE suffix:
#   .../chat/completions -> OpenAI chat_completions
#   .../responses -> OpenAI responses
#   .../v1/messages -> Anthropic messages
#   .../v1beta/models -> Gemini models
# MODEL_PROVIDER_<NAME>_CHAT_ENDPOINT remains available only as a legacy fallback when API_BASE has no suffix
# MODEL_PROVIDER_<NAME>_STREAM=true/false (optional, use true for gateways that require stream=true)
MODEL_PROVIDER_GEMINI_PROVIDER=gemini
MODEL_PROVIDER_GEMINI_API_KEY=
MODEL_PROVIDER_GEMINI_API_BASE=
MODEL_PROVIDER_GEMINI_STREAM=false

MODEL_PROVIDER_OPENAI_PROVIDER=openai
MODEL_PROVIDER_OPENAI_API_KEY=
MODEL_PROVIDER_OPENAI_API_BASE=
MODEL_PROVIDER_OPENAI_STREAM=false

MODEL_PROVIDER_ANTHROPIC_PROVIDER=anthropic
MODEL_PROVIDER_ANTHROPIC_API_KEY=
MODEL_PROVIDER_ANTHROPIC_API_BASE=
MODEL_PROVIDER_ANTHROPIC_STREAM=false

MODEL_PROVIDER_ARK_PROVIDER=openai_compatible
MODEL_PROVIDER_ARK_API_KEY=
MODEL_PROVIDER_ARK_API_BASE=
MODEL_PROVIDER_ARK_STREAM=false

# Main model (chat + skill planning)
MAIN_PROVIDER_NAME=ARK
MAIN_MODEL=
MAIN_FALLBACKS=GEMINI:gemini-2.0-flash
MAIN_TIMEOUT_SEC=12
# Reasoning effort per role: none/minimal/low/medium/high, empty = don't send the param.
# Defaults: main=low, all others=none (disable thinking for speed).
MAIN_REASONING_EFFORT=low

# Vision model (image/sticker understanding)
VISION_PROVIDER_NAME=
VISION_MODEL=
VISION_FALLBACKS=
VISION_TIMEOUT_SEC=15
VISION_REASONING_EFFORT=none

# Decision model (reply/skip)
DECISION_PROVIDER_NAME=
DECISION_MODEL=
DECISION_FALLBACKS=
DECISION_TIMEOUT_SEC=6
DECISION_REASONING_EFFORT=none

# Moderation model
MODERATION_PROVIDER_NAME=
MODERATION_MODEL=
MODERATION_FALLBACKS=
MODERATION_TIMEOUT_SEC=8
MODERATION_REASONING_EFFORT=none

# Compress model (kept for compatibility with other services)
COMPRESS_PROVIDER_NAME=
COMPRESS_MODEL=
COMPRESS_FALLBACKS=
COMPRESS_TIMEOUT_SEC=12
COMPRESS_REASONING_EFFORT=none

# Embedding model
EMBED_PROVIDER_NAME=
EMBED_MODEL=text-embedding-004
EMBED_FALLBACKS=
EMBED_TIMEOUT_SEC=10
LLM_RETRY_ATTEMPTS=2
LLM_RETRY_BACKOFF_SEC=0.8
LLM_RETRY_TIMEOUT_MULTIPLIER=1.35

# Bot runtime
MAX_CONTEXT_TOKENS=256000
MAX_OUTPUT_TOKENS=64000
BOT_ENABLE_TYPING=true
BOT_ENABLE_STREAMING=true
# 入站连续消息的最大合并等待时间；机器人会根据消息强度提前回复，不会机械等满
BOT_INBOUND_DEBOUNCE_SECONDS=5
BOT_STREAM_CHUNK_SIZE=36
BOT_STREAM_EDIT_INTERVAL_SEC=1.0
BOT_AUTO_DELETE_MINUTES=0
BOT_DECISION_CONTEXT_ITEMS=5
# 主动话题（群冷场时 bot 主动抛话题，/proactive 按群开关）
BOT_PROACTIVE_DEFAULT_ENABLED=false
BOT_PROACTIVE_IDLE_MINUTES=180
BOT_PROACTIVE_JITTER_MINUTES=60
BOT_PROACTIVE_CHECK_INTERVAL_SECONDS=60
BOT_PROACTIVE_QUIET_HOURS_START=0
BOT_PROACTIVE_QUIET_HOURS_END=9
BOT_PROACTIVE_RETRY_MINUTES=30
# 兜底贴纸池：逗号分隔的 sticker file_id 列表（可留空）
SKILL_STICKER_FILE_IDS=

# 入群验证：新成员先全员禁言，点群内按钮跳转 bot 私聊，在私聊内点按钮
# 弹出 Telegram Mini App，完成 Cloudflare Turnstile 真人质询后恢复权限；
# 超时被移出群聊（可重新加入再试）。验证页在 Telegram 内弹窗打开，不显示网址。
# 需要 bot 是群管理员且有「封禁用户」权限。开启时以下 Turnstile 密钥与公网地址均为必填。
# Turnstile 密钥在 Cloudflare 控制台创建（Widget 类型选 Managed），
# 允许域名填 PUBLIC_BASE_URL 的域名。Mini App 要求该地址必须是 https。
# 以下 Turnstile 参数由入群验证和低置信度消息审查质询共用。
JOIN_VERIFICATION_ENABLED=false
JOIN_VERIFICATION_TIMEOUT_SECONDS=600
JOIN_VERIFICATION_CHECK_INTERVAL_SECONDS=30
JOIN_VERIFICATION_TURNSTILE_SITE_KEY=
JOIN_VERIFICATION_TURNSTILE_SECRET_KEY=
# 验证页对外可访问的 https 地址（Cloudflare Tunnel / 反代到下面的监听端口）
JOIN_VERIFICATION_PUBLIC_BASE_URL=
JOIN_VERIFICATION_LISTEN_HOST=0.0.0.0
JOIN_VERIFICATION_LISTEN_PORT=8480

# Doubao TTS
DOUBAO_TTS_ENABLED=false
DOUBAO_TTS_HTTP_TIMEOUT_SEC=20
DOUBAO_TTS_MAX_TEXT_LENGTH=500
DOUBAO_TTS_API_BASE=https://openspeech.bytedance.com
DOUBAO_TTS_APP_ID=
DOUBAO_TTS_APP_KEY=
DOUBAO_TTS_ACCESS_KEY=
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_MODEL=
DOUBAO_TTS_SPEAKER=
DOUBAO_TTS_AUDIO_FORMAT=ogg_opus
DOUBAO_TTS_SAMPLE_RATE=48000
DOUBAO_TTS_BIT_RATE=96000
DOUBAO_TTS_EMOTION=
DOUBAO_TTS_EMOTION_SCALE=4
DOUBAO_TTS_SPEECH_RATE=0
DOUBAO_TTS_LOUDNESS_RATE=0
DOUBAO_TTS_SILENCE_DURATION_MS=0

# Sub2API gateway query skill (list models / model liveness)
SUB2API_ENABLED=false
SUB2API_BASE_URL=
SUB2API_API_KEY=
SUB2API_HTTP_TIMEOUT_SEC=15
SUB2API_CHECK_TIMEOUT_SEC=45

# GD Studio music API skill
MUSIC_API_ENABLED=true
MUSIC_API_HTTP_TIMEOUT_SEC=15
MUSIC_API_BASE_URL=https://music-api.gdstudio.xyz/api.php
MUSIC_API_DEFAULT_SOURCE=kuwo
MUSIC_API_STABLE_SOURCES=kuwo,netease,joox,bilibili
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# AV search
AV_ENABLED=true
AV_HTTP_TIMEOUT_SEC=15
AV_MAX_RESULTS=18
AV_JAVBUS_BASE_URL=https://www.javbus.com
AV_MADOUQU_BASE_URL=https://madouqu.com
AV_DMM_BASE_URL=https://www.dmm.co.jp
AV_FC2_BASE_URL=https://adult.contents.fc2.com

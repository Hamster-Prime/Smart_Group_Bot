# Bootstrap settings only. All runtime and group settings are managed in the
# Telegram Mini App after startup.

# Telegram bot identity. Create the bot with @BotFather.
BOT_TOKEN=

# Break-glass owner identity used to authenticate the settings Mini App.
SUPER_ADMIN_ID=

# Master key for encrypting provider, captcha, TTS and gateway secrets in the
# database. Use a long random value and keep it stable across restarts/backups.
CONFIG_MASTER_KEY=

# Database location/credentials are needed before database-backed settings can
# be loaded.
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Public HTTPS origin routed to the listener below. Telegram opens
# ${MINIAPP_PUBLIC_BASE_URL}/settings and /verify inside the Mini App.
MINIAPP_PUBLIC_BASE_URL=
MINIAPP_LISTEN_HOST=0.0.0.0
MINIAPP_LISTEN_PORT=8480

# Optional Telegram webhook transport. Both values are required to enable it;
# WEBHOOK_SECRET must contain 32-256 letters, digits, underscores or hyphens.
# Use a public HTTPS URL whose path is forwarded to MINIAPP_LISTEN_HOST:PORT.
# Missing or invalid values are logged and automatically fall back to polling.
WEBHOOK_URL=
WEBHOOK_SECRET=
